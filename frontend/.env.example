# LAN IP of the host laptop (the one running the full stack), not
# 127.0.0.1/localhost - other laptops on the same network resolve those to
# THEMSELVES, not this machine. Find it with `ipconfig getifaddr en0` (Wi-Fi)
# on macOS, or just run ../scripts/set-lan-ip.sh from the repo root, which
# rewrites every URL below (plus the backend's CORS allowlists) for you.
VITE_API_URL=http://127.0.0.1:3001/api
VITE_EMOTION_API_BASE_URL=http://127.0.0.1:5002
VITE_ANALYTICS_API_URL=http://127.0.0.1:8000
VITE_EMOTION_API_URL=http://127.0.0.1:8000
VITE_ADAPTIVE_API_URL=http://127.0.0.1:5005/api
VITE_STUDENT_PROFILE_API_URL=http://127.0.0.1:5010
